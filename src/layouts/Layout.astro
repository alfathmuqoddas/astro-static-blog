---
import "../styles/global.css";
import TableOfContent from "../components/TableOfContent.astro";

interface Props {
  title: string;
  description: string;
  isBlog?: boolean;
  navigation?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, isBlog, navigation } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧑‍🚀</text></svg>"/>
  <meta name="description" content={description} />
  <title>{title}</title>
</head>

<body class="bg-slate-50 font-sans text-slate-900 antialiased min-h-screen flex flex-col">
  <nav class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200 py-4">
    <div class="max-w-6xl mx-auto px-6 flex justify-between items-center">
      <a href={import.meta.env.BASE_URL} class="font-bold text-2xl text-blue-600 tracking-tight">MyBlog</a>
      <div class="space-x-8 text-sm font-medium text-slate-600">
        <a href={import.meta.env.BASE_URL} class="hover:text-blue-600 transition">Home</a>
        <a href={import.meta.env.BASE_URL + "/blog"} class="hover:text-blue-600 transition">Blog</a>
        <a href={import.meta.env.BASE_URL + "/about"} class="hover:text-blue-600 transition">About</a>
      </div>
    </div>
  </nav>

  <main class="flex-grow">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class={isBlog ? "grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-12" : ""}>
        
        <div class="min-w-0">
          <slot />
        </div>

        {isBlog && navigation && navigation.length > 0 && (
          <TableOfContent navigation={navigation} />
        )}
      </div>
    </div>
  </main>

  <footer class="mt-auto py-10 border-t border-slate-200 text-center">
    <p class="text-slate-500 text-sm">
      &copy; {new Date().getFullYear()} MyBlog. All rights reserved.
    </p>
  </footer>
</body>
</html>