---
interface Props {
  navigation: Array<{ depth: number; slug: string; text: string }>;
}
const { navigation } = Astro.props;
---
<aside class="hidden lg:block">
  <div class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto pr-4 custom-scrollbar">
    <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">
      On this page
    </h2>
    <nav>
      <ul class="space-y-3 border-l border-slate-200 ml-1">
        {navigation.map((heading) => (
          <li class:list={[
            "pl-4",
            heading.depth <= 2 ? "font-medium" : "text-sm pl-8 text-slate-500"
          ]}>
            <a 
              href={`#${heading.slug}`} 
              class="block text-slate-600 hover:text-blue-600 transition-colors border-l-2 border-transparent -ml-[17px] pl-4 hover:border-blue-400"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<style>
  /* Optional: Make the sidebar scrollbar slim and elegant */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0; /* slate-200 */
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1; /* slate-300 */
  }
</style>