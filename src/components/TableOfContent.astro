---
interface Props {
  navigation: Array<{ depth: number; slug: string; text: string }>;
}
const { navigation } = Astro.props;
---
<aside class="hidden lg:block">
  <details 
    class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto pr-4 custom-scrollbar group" 
    open
  >
    <summary class="list-none cursor-pointer outline-none">
      <h2 class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-slate-400 mb-4 hover:text-slate-600 transition-colors">
        On this page
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-3 w-3 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
        </svg>
      </h2>
    </summary>

    <nav class="pb-4">
      <ul class="space-y-3 border-l border-slate-200 ml-1">
        {navigation.map((heading) => (
          <li class:list={[
            "pl-4",
            heading.depth <= 2 ? "font-medium" : "text-sm pl-8 text-slate-500"
          ]}>
            <a 
              href={`#${heading.slug}`} 
              class="block text-slate-600 hover:text-blue-600 transition-colors border-l-2 border-transparent -ml-[17px] pl-4 hover:border-blue-400"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
</aside>

<style>
    .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0; /* slate-200 */
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1; /* slate-300 */
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toc-active {
    color: #2563eb; /* blue-600 */
    border-left-color: #60a5fa; /* blue-400 */
    font-weight: 600;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Scope to the main content column
    const content = document.querySelector("main .min-w-0");
    if (!content) return;

    const headings = content.querySelectorAll("h2[id], h3[id]");
    const links = document.querySelectorAll('aside a[href^="#"]');

    if (!headings.length || !links.length) return;

    const linkMap = new Map();
    links.forEach(link => {
      const id = link.getAttribute("href")?.slice(1);
      if (id) linkMap.set(id, link);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;

          const link = linkMap.get(entry.target.id);
          if (!link) return;

          links.forEach(l => l.classList.remove("toc-active"));
          link.classList.add("toc-active");
        });
      },
      {
        rootMargin: "0px 0px -70% 0px",
        threshold: 0.1
      }
    );

    headings.forEach(h => observer.observe(h));
  });
</script>